// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OFFICE_STAFF
  DELIVERY
}

enum ScanStatus {
  PROCESSING
  DELIVERED
  RETURNED
}

enum ScanType {
  EMS
  PARCEL
  REGISTERED
  UNKNOWN
  BAG
  ITEM
}

enum ReceptacleStatus {
  OPEN
  CLOSED
  IMPORTED_TO_IPS
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  INFO
  ALERT
  TASK
  SECURITY
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  AUDIO
  IMAGE
  VIDEO
  DOCUMENT
}

enum VerificationSessionStatus {
  PENDING
  REVIEWING
  VERIFIED
}

enum VerificationImageType {
  BAG
  ITEM
}

model User {
  id       String @id @default(cuid())
  username String @unique
  pin      String?
  password String?

  fullName  String
  role      UserRole  @default(OFFICE_STAFF)
  jobTitle  String?
  email     String? @unique
  phone     String?
  location  String?
  avatar    String?
  pinMustChange Boolean @default(false)

  scans Scan[]
  tasks Task[]
  notifications Notification[]
  messages Message[]
  participants Participant[]
  receptacles Receptacle[]
  verificationSessions VerificationSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([createdAt])
}

model VerificationSession {
  id        String   @id @default(cuid())
  status    VerificationSessionStatus   @default(PENDING)

  images    VerificationImage[]

  submitterId String
  submitter   User @relation(fields: [submitterId], references: [id])

  createdAt DateTime @default(now())

  @@index([status])
  @@index([submitterId])
  @@index([createdAt])
}

model VerificationImage {
  id        String   @id @default(cuid())
  type      VerificationImageType
  base64    String

  sessionId String
  session   VerificationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model Scan {
  id        String   @id @default(cuid())
  barcode   String   @unique
  weight    Float
  type      ScanType
  origin    String
  status    ScanStatus   @default(PROCESSING)
  deliveredTo String?
  imageUrl  String?
  scannerId String
  scanner   User     @relation(fields: [scannerId], references: [id])
  receptacleId String?
  receptacle   Receptacle? @relation(fields: [receptacleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scannerId])
  @@index([receptacleId])
  @@index([status])
  @@index([createdAt])
}

model Receptacle {
  id          String   @id
  originImpc  String
  destImpc    String
  weight      Float
  status      ReceptacleStatus   @default(OPEN)

  scannedById String
  scannedBy   User     @relation(fields: [scannedById], references: [id])
  items       Scan[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scannedById])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String
  actorId   String
  actorName String
  actorRole String
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority   @default(MEDIUM)
  dueDate     DateTime?

  assignedToId String?
  assignedTo   User?    @relation(fields: [assignedToId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      NotificationType   @default(INFO)
  isRead    Boolean  @default(false)

  userId    String?  // If null, it's a system-wide alert
  user      User?    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Conversation {
  id           String       @id @default(cuid())
  type         ConversationType       @default(DIRECT)
  name         String?
  avatar       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  participants Participant[]
  messages     Message[]

  @@index([updatedAt])
}

model Participant {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  joinedAt       DateTime     @default(now())

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  content        String?
  type           MessageType       @default(TEXT)
  fileUrl        String?
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}
