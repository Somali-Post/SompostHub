// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       String @id @default(cuid())
  username String @unique
  pin      String?
  password String?

  fullName  String
  role      String  @default("OFFICE_STAFF")
  jobTitle  String?
  email     String? @unique
  phone     String?
  location  String?
  avatar    String?
  pinMustChange Boolean @default(false)

  scans Scan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Scan {
  id        String   @id @default(cuid())
  barcode   String
  weight    Float
  type      String
  origin    String
  scannerId String
  scanner   User     @relation(fields: [scannerId], references: [id])
  createdAt DateTime @default(now())
}
